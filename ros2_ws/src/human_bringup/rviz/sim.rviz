Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Splitter Ratio: 0.6
    Tree Height: 420
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Color: 40; 200; 60
      Line Style: Lines
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Color: 40; 120; 255
      Line Style: Lines
      Topic:
        Value: /local_plan
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracked humans
      Enabled: true
      Topic:
        Value: /tracked_humans_markers
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        base_link:
          Value: true
        human_camera_link:
          Value: true
        human_camera_optical_frame:
          Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Human camera (RGB)
      Enabled: true
      Topic:
        Value: /human_camera/image_raw
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Tracked IDs (debug_image:=true)
      Enabled: true
      Topic:
        Value: /tracked_humans/debug_image
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Human camera (depth)
      Enabled: true
      Normalize Range: false
      Min Value: 0
      Max Value: 10
      Topic:
        Value: /human_camera/depth/image_raw
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      X: 0
      Y: 0
      Angle: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1500
  Height: 900
