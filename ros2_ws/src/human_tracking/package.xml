<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>human_tracking</name>
  <version>0.1.0</version>
  <description>DeepSORT tracking, 3D localization and map-frame transform of detected humans.</description>
  <maintainer email="avcibatuhan26@gmail.com">Batuhan Avcı</maintainer>
  <license>AGPL-3.0-only</license>

  <!-- deep-sort-realtime is not a ROS package: it comes from requirements.txt -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>human_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
